<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>home.attentionCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@items@</string>
        <key>items</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>Necesita atender 1 elemento</string><key>other</key><string>Necesita atender %lld elementos</string></dict>
    </dict>
    <key>home.folderSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@people@ · %2$#@documents@</string>
        <key>people</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 persona</string><key>other</key><string>%lld personas</string></dict>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 documento</string><key>other</key><string>%lld documentos</string></dict>
    </dict>
    <key>home.progressAccessibility</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$lld de %2$#@fields@ completos. %3$lld de %4$#@documents@ recibidos.</string>
        <key>fields</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 campo del formulario</string><key>other</key><string>%lld campos del formulario</string></dict>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 documento</string><key>other</key><string>%lld documentos</string></dict>
    </dict>
    <key>capture.pendingSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@documents@ · %2$@</string>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 documento en espera</string><key>other</key><string>%lld documentos en espera</string></dict>
    </dict>
    <key>capture.scanUsePages</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@pages@</string>
        <key>pages</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>Usar 1 página escaneada</string><key>other</key><string>Usar %lld páginas escaneadas</string></dict>
    </dict>
    <key>interview.voiceMinutesRemaining</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@minutes@</string>
        <key>minutes</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>Queda aproximadamente 1 minuto de voz</string><key>other</key><string>Quedan aproximadamente %lld minutos de voz</string></dict>
    </dict>
    <key>missing.questionSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@questions@ — aproximadamente %2$#@minutes@</string>
        <key>questions</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 pregunta breve</string><key>other</key><string>%lld preguntas breves</string></dict>
        <key>minutes</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 minuto</string><key>other</key><string>%lld minutos</string></dict>
    </dict>
    <key>catalog.requirementsSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@information@ · %2$#@documents@</string>
        <key>information</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 dato</string><key>other</key><string>%lld datos</string></dict>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 documento</string><key>other</key><string>%lld documentos</string></dict>
    </dict>
    <key>package.pageCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@pages@</string>
        <key>pages</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 página</string><key>other</key><string>%lld páginas</string></dict>
    </dict>
    <key>package.manifestOutput</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>- %1$@: %2$#@pages@</string>
        <key>pages</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 página</string><key>other</key><string>%lld páginas</string></dict>
    </dict>
    <key>package.manifestVerification</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Verificación: %1$#@fields@; %2$#@mismatches@</string>
        <key>fields</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 campo revisado</string><key>other</key><string>%lld campos revisados</string></dict>
        <key>mismatches</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 diferencia</string><key>other</key><string>%lld diferencias</string></dict>
    </dict>
</dict>
</plist>
