<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>home.attentionCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@items@</string>
        <key>items</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 item needs you</string><key>other</key><string>%lld items need you</string></dict>
    </dict>
    <key>home.folderSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@people@ · %2$#@documents@</string>
        <key>people</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 person</string><key>other</key><string>%lld people</string></dict>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 document</string><key>other</key><string>%lld documents</string></dict>
    </dict>
    <key>home.progressAccessibility</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$lld of %2$#@fields@ filled. %3$lld of %4$#@documents@ collected.</string>
        <key>fields</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 form field</string><key>other</key><string>%lld form fields</string></dict>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 document</string><key>other</key><string>%lld documents</string></dict>
    </dict>
    <key>capture.pendingSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@documents@ · %2$@</string>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 document waiting</string><key>other</key><string>%lld documents waiting</string></dict>
    </dict>
    <key>capture.scanUsePages</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@pages@</string>
        <key>pages</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>Use 1 scanned page</string><key>other</key><string>Use %lld scanned pages</string></dict>
    </dict>
    <key>interview.voiceMinutesRemaining</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@minutes@</string>
        <key>minutes</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>About 1 minute of voice time left</string><key>other</key><string>About %lld minutes of voice time left</string></dict>
    </dict>
    <key>missing.questionSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@questions@ — about %2$#@minutes@</string>
        <key>questions</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 quick question</string><key>other</key><string>%lld quick questions</string></dict>
        <key>minutes</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 minute</string><key>other</key><string>%lld minutes</string></dict>
    </dict>
    <key>catalog.requirementsSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@information@ · %2$#@documents@</string>
        <key>information</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 piece of information</string><key>other</key><string>%lld pieces of information</string></dict>
        <key>documents</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 document</string><key>other</key><string>%lld documents</string></dict>
    </dict>
    <key>package.pageCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@pages@</string>
        <key>pages</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 page</string><key>other</key><string>%lld pages</string></dict>
    </dict>
    <key>package.manifestOutput</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>- %1$@: %2$#@pages@</string>
        <key>pages</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 page</string><key>other</key><string>%lld pages</string></dict>
    </dict>
    <key>package.manifestVerification</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Verification: %1$#@fields@; %2$#@mismatches@</string>
        <key>fields</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 field checked</string><key>other</key><string>%lld fields checked</string></dict>
        <key>mismatches</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 mismatch</string><key>other</key><string>%lld mismatches</string></dict>
    </dict>
    <key>guided.minutes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@minutes@</string>
        <key>minutes</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 minute</string><key>other</key><string>%lld minutes</string></dict>
    </dict>
    <key>guided.estimatedMinutes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>About %#@minutes@</string>
        <key>minutes</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 minute</string><key>other</key><string>%lld minutes</string></dict>
    </dict>
    <key>guided.sessionSummary</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@minutes@ · %2$#@steps@</string>
        <key>minutes</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>About 1 minute</string><key>other</key><string>About %lld minutes</string></dict>
        <key>steps</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 step</string><key>other</key><string>%lld steps</string></dict>
    </dict>
    <key>proof.destinationCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@destinations@</string>
        <key>destinations</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>1 official-form destination</string><key>other</key><string>%lld official-form destinations</string></dict>
    </dict>
</dict>
</plist>
