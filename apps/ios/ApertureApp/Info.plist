<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDisplayName</key>
    <string>Aperture</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>ApertureRuntimeMode</key>
    <string>$(APERTURE_RUNTIME_MODE)</string>

    <!-- Purpose strings are user-facing copy and are localised alongside everything
         else. They say what we do with the data, not merely that we want access. -->
    <key>NSCameraUsageDescription</key>
    <string>Aperture uses the camera to photograph your documents so we can read the information from them. Photos stay on your device until you choose to upload them.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Aperture can use photos you already have of your documents. We only see the photos you pick.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Aperture uses the microphone only when you choose to answer questions by speaking. Audio goes straight from your device to the speech service and is not kept unless you ask us to keep it.</string>

    <!-- App Tracking Transparency is deliberately absent: there is no tracking, no
         advertising identifier and no third-party SDK in this app (ADR-012). -->

    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
